{
  "name": "tasklings",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:ci": "jest --ci"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "2.118.0",
    "expo": "58.0.16",
    "expo-clipboard": "58.0.3",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.10",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/targets/"
    ]
  }
}
