# Copy to app/.env.local (git-ignored) to run the app against a Supabase project.
# Leave either value empty or unset and the app keeps using the in-memory mock.
#
# Both values are PUBLIC BY DESIGN: Expo inlines every EXPO_PUBLIC_* variable into the JavaScript
# bundle, so anyone with the app can read them. What protects the data is row-level security and
# the sign-in session, not these values. Put the project URL and the anon / publishable key here.
# NEVER put the service-role (secret) key here, in app.json, or anywhere in app/ -- the app refuses
# to start with one.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
